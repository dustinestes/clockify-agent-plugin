{
  "name": "@dustinestes/clockify-agent-plugin",
  "version": "0.1.1",
  "description": "Unofficial Clockify time tracking for coding sessions - MCP tools plus workflow skills. Not affiliated with Clockify/Cake.com.",
  "type": "module",
  "bin": {
    "clockify-agent-plugin": "dist/index.js",
    "clockify-install-cursor": "scripts/install-cursor.mjs",
    "clockify-cursor-install": "scripts/install-cursor.mjs"
  },
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "mcp.json",
    ".mcp.json",
    "plugin.json",
    ".cursor-plugin",
    "assets",
    "docs",
    ".clockify/config.yml.example",
    "scripts/install-cursor.mjs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:handshake": "tsx scripts/handshake.ts",
    "test:config": "tsx scripts/check-config.ts",
    "check:versions": "node scripts/check-versions.mjs",
    "install:cursor": "node scripts/install-cursor.mjs",
    "sandbox:debug": "node scripts/sandbox-debug.mjs",
    "sandbox:teardown": "node scripts/sandbox-debug.mjs --teardown",
    "prepublishOnly": "npm run check:versions && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clockify",
    "time-tracking",
    "cursor",
    "claude",
    "agent-skills"
  ],
  "author": "Dustin Estes <clockify.mcpserver@dustinestes.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinestes/clockify-agent-plugin.git"
  },
  "homepage": "https://github.com/dustinestes/clockify-agent-plugin",
  "bugs": {
    "url": "https://github.com/dustinestes/clockify-agent-plugin/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
