# Example project standards for Clockify MCP.
# Copy to the consumer repo as `.clockify.yml` (or run the clockify-project-init skill).
# See docs/config.md for the full schema.
version: 1
project:
  name_from: repo
rounding:
  enabled: true
  increment_minutes: 15
  mode: nearest
description:
  template: "{issue_number} {issue_title}"
mapping:
  project: repo_name
  task_from: github_label
automation:
  triggers:
    - event: issue_start
      action: start_timer
    - event: issue_finish
      action: stop_timer
    - event: issue_switch
      action: stop_then_start
    - event: pr_ship
      action: stop_timer
  inactivity:
    enabled: true
    stop_after_minutes: 45
