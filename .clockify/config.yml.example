# Example project standards for Clockify MCP.
# Init writes this as `.clockify/config.yml` in the consumer repo (or copy manually).
# Personal by default — see docs/config.md (git hygiene). Never put API keys here.
version: 1
project:
  name_from: repo

timer:
  include_seconds: false
  description:
    from: prompt
    template: "{issue_number} - {issue_title}"
  task:
    from: prompt
    if_missing: prompt
  rounding:
    enabled: true
    increment_minutes: 15
    mode: nearest
    start_mode: nearest
    stop_mode: nearest
    minimum_minutes: 15
  overlap:
    on_conflict: prompt

manual:
  description:
    from: prompt
    template: "{issue_number} - {issue_title}"
  task:
    from: prompt
    if_missing: prompt
  overlap:
    on_conflict: prompt

automated:
  include_seconds: false
  description:
    from: template
    template: "{issue_number} - {issue_title}"
  task:
    from: github_label
    if_missing: create
  rounding:
    enabled: true
    increment_minutes: 15
    mode: nearest
    start_mode: nearest
    stop_mode: nearest
    minimum_minutes: 15
  overlap:
    on_conflict: prompt
  triggers:
    - event: issue_start
      action: start_timer
    - event: issue_finish
      action: stop_timer
    - event: issue_switch
      action: stop_then_start
    - event: pr_ship
      action: stop_timer
    - event: pr_closed
      action: stop_timer
  inactivity:
    enabled: true
    stop_after_minutes: 45
