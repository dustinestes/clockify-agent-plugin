# Clockify Agent Plugin (@dustinestes/clockify-agent-plugin) — https://github.com/dustinestes/clockify-agent-plugin — docs/config.md
plugin:
  version: 3
scope:
  workspace_id: SET_BY_INIT
  project:
    from: local_folder

entry:
  timer:
    include_seconds: false
    description:
      from: prompt
      template: "{issue_number} - {issue_title}"
    task:
      from: prompt
      if_missing: prompt
    rounding:
      enabled: true
      increment_minutes: 15
      mode: nearest
      start_mode: nearest
      stop_mode: nearest
      minimum_minutes: 15
    overlap:
      on_conflict: prompt

  manual:
    description:
      from: prompt
    task:
      from: prompt
      if_missing: prompt
    overlap:
      on_conflict: prompt

  automated:
    enabled: false
    forge: none
    include_seconds: false
    on_start:
      when_multiple_labels: first
      description:
        from: prompt
      task:
        from: none
        if_missing: none
    rounding:
      enabled: true
      increment_minutes: 15
      mode: nearest
      start_mode: nearest
      stop_mode: nearest
      minimum_minutes: 15
    overlap:
      on_conflict: prompt
    triggers: []
    inactivity:
      enabled: true
      stop_after_minutes: 45
    platforms:
      cursor:
        enabled: false
        modes: {}
