# Maintainer Sandbox
# Not read by the MCP server. --sandbox bakes this into sandbox mcp.json env.
# Do not put consumer CLOCKIFY_API_KEY here — that is for MCP/plugin hosts.
CLOCKIFY_API_KEY_SANDBOX=

# Optional consumer/MCP env (set in mcp.json, not this file): CLOCKIFY_MCP_LOG=debug|info|error|off
# Default is info. Sandbox mcp.json sets debug and CLOCKIFY_MCP_SANDBOX=1. See docs/logging.md.

