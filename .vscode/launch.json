{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sandbox",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/sandbox-debug.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"],
      "postDebugTask": "sandbox:teardown:force"
    },
    {
      "name": "Sandbox: teardown",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/sandbox-debug.mjs",
      "args": ["--teardown"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
