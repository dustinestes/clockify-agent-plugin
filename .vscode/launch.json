{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sandbox",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/sandbox-debug.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"],
      // Default is forceful (SIGKILL → red "Killed"). Polite sends SIGTERM so
      // the script can exit 0; postDebugTask still force-tears down the sandbox.
      "killBehavior": "polite",
      "postDebugTask": "sandbox:teardown:force"
    },
    {
      "name": "Sandbox: teardown",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/sandbox-debug.mjs",
      "args": ["--teardown"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
